NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hms
# Tests use a separate database whose name ends in _test.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/hms_test

# Authentication and sessions (HMS-05)
# SESSION_SECRET is required. Use a long random string of your own. Do not commit it.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=0