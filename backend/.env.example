NODE_ENV=development
PORT=5000
# MongoDB Atlas URI for development; put real credentials only in the untracked .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms
# Separate MongoDB Atlas URI for tests; put real credentials only in the untracked .env.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms_test

# Authentication and sessions (HMS-05)
# SESSION_SECRET is required. Use a long random string of your own. Do not commit it.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=0